# ---------------------------------------------------------------------------
# Source MSSQL connection (real data -- typically sql-kubota-dev)
# ---------------------------------------------------------------------------
MSSQL_SOURCE_SERVER=sql-kubota-dev.database.windows.net
MSSQL_SOURCE_DATABASE=kubota
MSSQL_SOURCE_USERNAME=your_source_user
MSSQL_SOURCE_PASSWORD=your_source_password
MSSQL_SOURCE_DRIVER=ODBC Driver 18 for SQL Server

# ---------------------------------------------------------------------------
# Target MSSQL connection (synthetic copy -- typically sql-kubota-dev_copy)
# ---------------------------------------------------------------------------
MSSQL_TARGET_SERVER=sql-kubota-dev-copy.database.windows.net
MSSQL_TARGET_DATABASE=kubota
MSSQL_TARGET_USERNAME=your_target_user
MSSQL_TARGET_PASSWORD=your_target_password
MSSQL_TARGET_DRIVER=ODBC Driver 18 for SQL Server

# ---------------------------------------------------------------------------
# Schema / path settings
# ---------------------------------------------------------------------------
SOURCE_SCHEMA=dbo
TARGET_SCHEMA=dbo
MODELS_DIR=./artifacts/models
LOG_LEVEL=INFO
